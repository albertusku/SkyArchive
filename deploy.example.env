# Copy this file to deploy.meteo.env and adjust values for your machine.

REMOTE_USER=meteo-user
REMOTE_HOST=meteo-host
REMOTE_DIR=/opt/meteo

# Optional overrides. Defaults are derived from REMOTE_DIR when omitted.
REMOTE_STORAGE_DIR=/opt/meteo/src/Data_storage/Storage
REMOTE_LOG_DIR=/opt/meteo/src/Logs

# Systemd service rendering.
# Defaults for direct Raspberry Pi installs:
# SERVICE_USER=current user
# APP_DIR=current repo root
# METEO_VENV_DIR=${APP_DIR}/meteo_python
SERVICE_USER=meteo-user
APP_DIR=/opt/meteo
METEO_VENV_DIR=/opt/meteo/meteo_python
DASHBOARD_PORT=8502
DASHBOARD_ADDRESS=0.0.0.0
